{
  "version": 1,
  "collection": {
    "rate_limit_seconds": 1,
    "connection_timeout_seconds": 10,
    "read_timeout_seconds": 10,
    "total_timeout_seconds": 15,
    "max_retries": 3,
    "backoff_initial_seconds": 5,
    "backoff_max_seconds": 60
  },
  "aggregation": {
    "window_hours": 3,
    "window_overlap_hours": 1,
    "window_step_hours": 3,
    "stale_threshold_hours": 48,
    "min_category_impact": 0.25
  },
  "digest": {
    "concurrency": 10,
    "content_char_limit": 12000
  },
  "retention": {
    "staging_article_days": 3,
    "archived_event_days": 30
  },
  "pipeline": {
    "watchdog_timeout_minutes": 30,
    "max_item_retries": 3
  }
}
