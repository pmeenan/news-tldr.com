{
  "version": 1,
  "collection": {
    "rate_limit_seconds": 1,
    "connection_timeout_seconds": 10,
    "read_timeout_seconds": 10,
    "total_timeout_seconds": 15,
    "max_retries": 3,
    "backoff_initial_seconds": 5,
    "backoff_max_seconds": 60
  },
  "aggregation": {
    "window_hours": 3,
    "window_overlap_hours": 1,
    "window_step_hours": 3,
    "stale_threshold_hours": 48,
    "category_batch_concurrency": 8,
    "deduplication_concurrency": 4,
    "deduplication_max_pairs_per_run": 40,
    "deduplication_max_passes_per_run": 1,
    "min_category_impact": 0.25
  },
  "digest": {
    "concurrency": 10,
    "content_char_limit": 12000,
    "filter_review_enabled": true,
    "filter_review_margin": 0.1
  },
  "editorial": {
    "concurrency": 2,
    "article_char_limit": 12000,
    "event_char_limit": 40000
  },
  "presentation": {
    "site_url": "https://news-tldr.com",
    "rolling_window_hours": 72,
    "reader_sync_enabled": true,
    "publish_enabled": true,
    "publish_dir": "/var/www/news-tldr.com"
  },
  "operations": {
    "max_pipeline_age_hours": 3,
    "max_failed_feeds": 5,
    "max_article_failures": 25
  },
  "retention": {
    "staging_article_days": 3,
    "archived_event_days": 30
  },
  "pipeline": {
    "watchdog_timeout_minutes": 30,
    "max_item_retries": 3
  }
}
