# Local environment template for news-tldr.com.
# Copy to .env and fill in real secrets locally.

# Google Gemini Developer API key from Google AI Studio.
GEMINI_API_KEY=

# Backward-compatible default when a stage-specific model is not configured.
GEMINI_MODEL=gemini-3.5-flash-lite

# High-volume digest, grouping, filtering, and candidate-discovery model.
GEMINI_BULK_MODEL=gemini-3.5-flash-lite

# Higher-precision model for borderline article filtering, editorial, and final event-merge review.
GEMINI_REVIEW_MODEL=gemini-3.8-flash

# Ordered full-Flash capacity fallbacks. Editorial never falls back to Lite.
GEMINI_REVIEW_FALLBACK_MODELS=gemini-3.7-flash

# Expensive last resort (twice the 3.8/3.7 price) used only by editorial verification.
GEMINI_REVIEW_LAST_RESORT_MODELS=gemini-3.5-flash

# Model for the half-price flex attempt that precedes the standard chain; llm.flex_budget_seconds
# in config/pipeline.json sets per-purpose budgets. GEMINI_FLEX_DISABLED=1 turns flex off.
GEMINI_REVIEW_FLEX_MODEL=gemini-3.7-flash

# Deduplication-only last resort. Flash-Lite may reject a pair but cannot authorize a merge.
GEMINI_REVIEW_LITE_FALLBACK_MODEL=gemini-3.5-flash-lite

# Fail over quickly on capacity errors and temporarily bypass the saturated tier.
GEMINI_REVIEW_ATTEMPTS_PER_MODEL=1
GEMINI_CAPACITY_COOLDOWN_SECONDS=300
