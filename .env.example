# Local environment template for news-tldr.com.
# Copy to .env and fill in real secrets locally.

# Google Gemini Developer API key from Google AI Studio.
GEMINI_API_KEY=

# Backward-compatible default when a stage-specific model is not configured.
GEMINI_MODEL=gemini-3.5-flash-lite

# High-volume digest, grouping, filtering, and candidate-discovery model.
GEMINI_BULK_MODEL=gemini-3.5-flash-lite

# Higher-precision model for borderline article filtering, editorial, and final event-merge review.
GEMINI_REVIEW_MODEL=gemini-3.8-flash

# Ordered full-Flash capacity fallbacks. Editorial never falls back to Lite.
GEMINI_REVIEW_FALLBACK_MODELS=gemini-3.7-flash

# Expensive last resort (twice the 3.8/3.7 price) used only by editorial verification.
GEMINI_REVIEW_LAST_RESORT_MODELS=gemini-3.5-flash

# Ordered half-price Flex pools, retried for llm.flex_retry_seconds before standard pricing.
# GEMINI_FLEX_DISABLED=1 disables Flex. The legacy singular setting moves a model first.
GEMINI_REVIEW_FLEX_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash

# Deduplication-only last resort. Flash-Lite may reject a pair but cannot authorize a merge.
GEMINI_REVIEW_LITE_FALLBACK_MODEL=gemini-3.5-flash-lite

# Fail over quickly on capacity errors and temporarily bypass the saturated tier.
GEMINI_REVIEW_ATTEMPTS_PER_MODEL=1
GEMINI_CAPACITY_COOLDOWN_SECONDS=300

# Backend choices: gemini, openrouter (one explicit model), free-first.
# Production opts into free-first: Union -> Flash; Nemotron -> Union -> Flash-Lite.
# Price/quota checks and bounded attempts are configured in llm.free_routing.
LLM_BACKEND=gemini
# LLM_BACKEND=free-first
# LLM_BULK_BACKEND=openrouter
# LLM_REVIEW_BACKEND=openrouter
OPENROUTER_API_KEY=
# Set an explicit OpenRouter catalog ID when selecting that backend.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_BULK_MODEL=vendor/model
# OPENROUTER_REVIEW_MODEL=vendor/model
# OPENROUTER_MAX_OUTPUT_TOKENS=32768
# OPENROUTER_REASONING_EFFORT=low
# Default requires JSON Schema support; json_object is an explicit alternative.
# OPENROUTER_RESPONSE_FORMAT=json_schema
# Pin a provider for repeatable evaluations (use its catalog slug):
# OPENROUTER_PROVIDER_PREFERENCES='{"only":["provider-slug"],"allow_fallbacks":false}'
