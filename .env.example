# Local environment template for news-tldr.com.
# Copy to .env and fill in real secrets locally.

# Google Gemini Developer API key from Google AI Studio.
GEMINI_API_KEY=

# Backward-compatible default when a stage-specific model is not configured.
GEMINI_MODEL=gemini-3.5-flash-lite

# High-volume digest, grouping, filtering, and candidate-discovery model.
GEMINI_BULK_MODEL=gemini-3.5-flash-lite

# Higher-precision model for borderline article filtering and final event-merge review.
GEMINI_REVIEW_MODEL=gemini-3.7-flash
